{
  "manifest_version": 3,
  "name": "Website Permission Auditor",
  "short_name": "Permission Auditor",
  "description": "Audit camera, microphone, location, notifications, clipboard and host access for the site you are viewing.",
  "version": "1.1.0",
  "minimum_chrome_version": "104",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Website Permission Auditor",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "tabs", "contentSettings", "permissions", "storage", "favicon"]
}
